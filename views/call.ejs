<%- include('partials/header') %>
<%
  const tel = (supportPhone || '').replace(/[^\d+]/g, '');
  const reasons = [
    ['<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>', t('call.reason_account')],
    ['<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 .5c0 2-2.5 2-2.5 4M12 17h.01"/>', t('call.reason_questions')],
    ['<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5"/>', t('call.reason_events')]
  ];
%>
<div class="mx-auto max-w-xl">
  <%# warm peach welcome (Fortune, ref 6) with one huge yolk phone button (Lightyear CTA, ref 5) %>
  <div class="hero-warm mb-6 rounded-4xl px-5 pt-6 pb-6 text-center md:px-8">
    <img src="/images/illustrations/phone-call.svg" alt="" class="mx-auto mb-2 h-36 w-36" width="144" height="144">
    <h1 class="mb-5"><%= t('call.title') %></h1>
    <% if (tel) { %>
      <a href="tel:<%= tel %>" class="btn-coral btn-block min-h-20 rounded-3xl text-2xl font-bold">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-charcoal text-xl text-yolk-400"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
        <span class="min-w-0"><%= t('call.call_now', { phone: supportPhone }) %></span>
      </a>
    <% } else { %>
      <p class="rounded-3xl bg-surface p-5 text-lg"><%= t('call.no_number') %></p>
    <% } %>
    <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-surface px-4 py-2 font-semibold"><i class="fa-regular fa-clock text-primary" aria-hidden="true"></i><%= hours %></p>
  </div>

  <div class="card">
    <h2 class="mb-4 text-2xl"><%= t('call.help_with') %></h2>
    <ul class="space-y-4">
      <% reasons.forEach(function (r) { %>
        <li class="flex items-center gap-4">
          <span class="icon-tile"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- r[0] %></svg></span>
          <span class="min-w-0 text-lg"><%= r[1] %></span>
        </li>
      <% }) %>
    </ul>
  </div>
</div>

<%- include('partials/footer') %>
