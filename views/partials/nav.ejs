<%# staff sidebar (left on computers, a scrolling bar on phones). Light theme, same palette (Halden layout, ref 3) %>
<%
  const links = [
    { href: '/admin', label: 'Dashboard', icon: 'fa-chart-pie' },
    { href: '/admin/events', label: 'Events', icon: 'fa-calendar-days' },
    { href: '/admin/organizations', label: 'Organizations', icon: 'fa-building' },
    { href: '/admin/seniors', label: 'Seniors', icon: 'fa-users' },
    { href: '/admin/ids', label: 'ID checks', icon: 'fa-id-card' },
    { href: '/admin/reports', label: 'Reports', icon: 'fa-flag' },
    { href: '/admin/onboarding-video', label: 'Welcome video', icon: 'fa-circle-play' },
    { href: '/admin/staff', label: 'Staff', icon: 'fa-user-shield' },
    { href: '/admin/system', label: 'System', icon: 'fa-gear' }
  ];
%>
<aside class="border-b border-hairline bg-surface md:sticky md:top-0 md:flex md:h-screen md:w-64 md:shrink-0 md:flex-col md:border-r md:border-b-0">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 md:py-6">
    <a href="/admin" class="brand">
      <span class="brand-mark"><i class="fa-solid fa-hand-holding-heart text-base" aria-hidden="true"></i></span>
      SeniorPadi
    </a>
    <span class="flex items-center gap-3">
      <span class="chip-status chip-locked"><i class="fa-solid fa-user-shield" aria-hidden="true"></i>Staff</span>
      <form action="/logout" method="post" data-confirm-logout class="md:hidden">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn-plain w-auto py-2" aria-label="Log out"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>Log out</button>
      </form>
    </span>
  </div>
  <nav aria-label="Admin" class="overflow-x-auto px-3 pb-3 md:flex-1 md:overflow-y-auto">
    <ul class="flex gap-1 md:flex-col">
      <% links.forEach(function (link) {
           const active = currentPath === link.href || (link.href !== '/admin' && currentPath.startsWith(link.href));
      %>
        <li>
          <a href="<%= link.href %>" <%= active ? 'aria-current=page' : '' %> class="admin-link">
            <i class="fa-solid <%= link.icon %> w-5 text-center" aria-hidden="true"></i><%= link.label %>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>
  <div class="hidden border-t border-hairline px-5 py-4 md:block">
    <p class="text-sm text-muted">Logged in as</p>
    <p class="mb-3 font-semibold break-words text-body"><%= currentUser.fullName %></p>
    <form action="/logout" method="post" data-confirm-logout>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-plain btn-block py-2"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>Log out</button>
    </form>
  </div>
</aside>
