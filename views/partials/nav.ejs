<%# staff sidebar (left on computers, a scrolling bar on phones) %>
<%
  const links = [
    { href: '/admin', label: 'Dashboard', icon: 'fa-chart-pie' },
    { href: '/admin/events', label: 'Events', icon: 'fa-calendar-days' },
    { href: '/admin/organizations', label: 'Organizations', icon: 'fa-building' },
    { href: '/admin/seniors', label: 'Seniors', icon: 'fa-users' },
    { href: '/admin/ids', label: 'ID checks', icon: 'fa-id-card' },
    { href: '/admin/reports', label: 'Reports', icon: 'fa-flag' },
    { href: '/admin/onboarding-video', label: 'Welcome video', icon: 'fa-circle-play' },
    { href: '/admin/staff', label: 'Staff', icon: 'fa-user-shield' },
    { href: '/admin/system', label: 'System', icon: 'fa-gear' }
  ];
%>
<aside class="bg-primary text-white md:sticky md:top-0 md:flex md:h-screen md:w-64 md:shrink-0 md:flex-col">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 md:py-6">
    <a href="/admin" class="flex min-h-12 items-center gap-2 text-xl font-bold text-white no-underline">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></span>
      SeniorPadi
    </a>
    <span class="flex items-center gap-3">
      <span class="rounded-full bg-accent px-3 py-1 text-sm font-bold text-white">Staff</span>
      <form action="/logout" method="post" class="md:hidden">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="inline-flex min-h-12 items-center gap-2 rounded-xl border-2 border-white px-4 text-base font-bold text-white transition-colors hover:bg-white/10" aria-label="Log out"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>Log out</button>
      </form>
    </span>
  </div>
  <nav aria-label="Admin" class="overflow-x-auto px-3 pb-3 md:flex-1 md:overflow-y-auto">
    <ul class="flex gap-2 md:flex-col">
      <% links.forEach(function (link) {
           const active = currentPath === link.href || (link.href !== '/admin' && currentPath.startsWith(link.href));
      %>
        <li>
          <a href="<%= link.href %>" <%= active ? 'aria-current=page' : '' %>
             class="flex min-h-12 items-center gap-3 whitespace-nowrap rounded-xl px-4 py-2 text-base font-bold no-underline transition-colors
                    <%= active ? 'bg-surface text-primary' : 'text-white hover:bg-white/10' %>">
            <i class="fa-solid <%= link.icon %> w-5 text-center" aria-hidden="true"></i><%= link.label %>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>
  <div class="hidden border-t-2 border-white/20 px-5 py-4 md:block">
    <p class="text-sm text-on-primary-muted">Logged in as</p>
    <p class="mb-3 break-words font-bold text-white"><%= currentUser.fullName %></p>
    <form action="/logout" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="inline-flex min-h-12 items-center gap-2 rounded-xl border-2 border-white px-4 text-base font-bold text-white transition-colors hover:bg-white/10"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>Log out</button>
    </form>
  </div>
</aside>
