<%
  // seniors and visitors get the simple menu; staff get the admin sidebar
  const isAdmin = currentUser && currentUser.role === 'admin';
  const otherLang = lang === 'en' ? 'yo' : 'en';
  const isWide = typeof wide !== 'undefined' && wide;
  const isFull = typeof fullWidth !== 'undefined' && fullWidth; // landing page: sections go edge to edge
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | SeniorPadi</title>
  <script>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/fonts/noto-sans-variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/main.css?v=ui1">
  <script src="/js/phone-input.js?v=ui1" defer></script>
</head>

<% if (isAdmin) { %>
<body class="min-h-screen bg-surface-subtle md:flex">
  <a href="#main" class="skip-link">Skip to main content</a>
  <%- include('nav') %>
  <div class="flex min-h-screen min-w-0 flex-1 flex-col">
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 md:px-10 md:py-10">
      <%- include('flash') %>
<% } else { %>
<body class="flex min-h-screen flex-col pb-28 md:pb-0">
  <a href="#main" class="skip-link"><%= t('nav.skip') %></a>

  <header class="site-header">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-2">
      <a href="/" class="flex min-h-12 items-center gap-3 text-lg font-bold text-primary no-underline sm:text-xl">
        <span class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-white sm:flex"><i class="fa-solid fa-hand-holding-heart text-base" aria-hidden="true"></i></span>
        SeniorPadi
      </a>

      <div class="flex items-center gap-3">
        <%# one button that always shows the OTHER language %>
        <form action="/language" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="<%= currentPath %>">
          <button name="lang" value="<%= otherLang %>" lang="<%= otherLang %>"
                  class="btn-plain w-auto px-4">
            <i class="fa-solid fa-language hidden sm:inline" aria-hidden="true"></i>
            <%= otherLang === 'yo' ? 'Yorùbá' : 'English' %>
          </button>
        </form>
        <a href="/call" class="btn-coral hidden lg:inline-flex">
          <i class="fa-solid fa-phone" aria-hidden="true"></i><%= t('call.title') %>
        </a>
        <% if (!currentUser) { %>
          <a href="/login" class="nav-link hidden text-primary sm:inline-flex"><%= t('home.login') %></a>
        <% } %>
      </div>
    </div>
  </header>

  <%# on computers the menu has its own bar under the header (it does not fit beside the buttons at 48px targets) %>
  <div class="hidden border-b-2 border-gray-200 bg-surface md:block">
    <div class="mx-auto max-w-6xl px-4 py-1"><%- include('seniorNav', { placement: 'top' }) %></div>
  </div>

  <%# on phones the same menu sits at the bottom of the screen %>
  <div class="md:hidden"><%- include('seniorNav', { placement: 'bottom' }) %></div>

  <main id="main" tabindex="-1" class="<%= isFull ? 'w-full' : (isWide ? 'page-wide' : 'page') %> flex-1">
    <% if (isFull) { %><div class="mx-auto max-w-6xl px-4 pt-4"><%- include('flash') %></div><% } else { %><%- include('flash') %><% } %>
<% } %>
