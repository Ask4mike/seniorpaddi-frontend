<%
  // seniors and visitors get the simple menu; staff get the admin sidebar
  const isAdmin = currentUser && currentUser.role === 'admin';
  const otherLang = lang === 'en' ? 'yo' : 'en';
  const isWide = typeof wide !== 'undefined' && wide;
  const isFull = typeof fullWidth !== 'undefined' && fullWidth; // landing page: sections go edge to edge
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | SeniorPadi</title>
  <meta name="theme-color" content="#fff9f0">
  <script>document.documentElement.classList.add('js');</script>
  <%# Outfit: one self-hosted variable file (400 to 700) covers every weight, so it is the only font file to preload %>
  <link rel="preload" href="/fonts/outfit-variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/main.css?v=ui2">
  <script src="/js/phone-input.js?v=ui1" defer></script>
</head>

<% if (isAdmin) { %>
<body class="min-h-screen bg-surface-subtle font-sans md:flex">
  <a href="#main" class="skip-link">Skip to main content</a>
  <%- include('nav') %>
  <div class="flex min-h-screen min-w-0 flex-1 flex-col">
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 md:px-10 md:py-10">
      <%- include('flash') %>
<% } else { %>
<body class="flex min-h-screen flex-col pb-28 font-sans md:pb-0">
  <a href="#main" class="skip-link"><%= t('nav.skip') %></a>

  <%# pill top bar: logo left, language and (on wide screens) Call and Log in on the right %>
  <header class="site-header">
    <div class="topbar">
      <a href="/" class="brand">
        <span class="brand-mark"><i class="fa-solid fa-hand-holding-heart text-base" aria-hidden="true"></i></span>
        SeniorPadi
      </a>

      <div class="flex items-center gap-2">
        <% if (!currentUser) { %>
          <a href="/login" class="nav-link hidden sm:inline-flex"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i><%= t('home.login') %></a>
        <% } %>
        <a href="/call" class="nav-link hidden lg:inline-flex">
          <i class="fa-solid fa-phone" aria-hidden="true"></i><%= t('call.title') %>
        </a>
        <%# one button that always shows the OTHER language %>
        <form action="/language" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="back" value="<%= currentPath %>">
          <button name="lang" value="<%= otherLang %>" lang="<%= otherLang %>" class="lang-pill">
            <i class="fa-solid fa-language" aria-hidden="true"></i>
            <%= otherLang === 'yo' ? 'Yorùbá' : 'English' %>
          </button>
        </form>
      </div>
    </div>

    <%# on computers the same five-item menu is a pill bar under the top bar %>
    <div class="mx-auto mt-3 hidden max-w-6xl md:block"><%- include('seniorNav', { placement: 'top' }) %></div>
  </header>

  <%# on phones the same menu sits at the bottom of the screen %>
  <div class="md:hidden"><%- include('seniorNav', { placement: 'bottom' }) %></div>

  <main id="main" tabindex="-1" class="<%= isFull ? 'w-full' : (isWide ? 'page-wide' : 'page') %> flex-1">
    <% if (isFull) { %><div class="mx-auto max-w-6xl px-4 pt-4"><%- include('flash') %></div><% } else { %><%- include('flash') %><% } %>
<% } %>
