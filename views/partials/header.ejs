<%
  // seniors and visitors get the simple menu; staff get the admin sidebar
  const isAdmin = currentUser && currentUser.role === 'admin';
  const otherLang = lang === 'en' ? 'yo' : 'en';
  const isWide = typeof wide !== 'undefined' && wide;
  const isFull = typeof fullWidth !== 'undefined' && fullWidth; // landing page: sections go edge to edge
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <%# viewport-fit=cover lets the top bar and bottom bar use the safe-area padding on notched phones %>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> | SeniorPadi</title>
  <meta name="theme-color" content="#fff9f0">
  <script>document.documentElement.classList.add('js');</script>
  <%# Outfit: one self-hosted variable file (400 to 700) covers every weight, so it is the only font file to preload %>
  <link rel="preload" href="/fonts/outfit-variable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="/css/main.css?v=ui3">
  <script src="/js/phone-input.js?v=ui1" defer></script>
  <%# page-change progress bar; the page works the same without it %>
  <script src="/js/top-loader.js?v=ui1" defer></script>
</head>

<% if (isAdmin) { %>
<body class="admin-area min-h-screen bg-surface-subtle font-sans md:flex">
  <%# thin page-loading bar at the very top (public/js/top-loader.js). Decorative: the browser shows its own loading state to screen readers %>
  <div id="top-loader" class="top-loader" role="progressbar" aria-hidden="true"></div>
  <a href="#main" class="skip-link">Skip to main content</a>
  <%- include('nav') %>
  <div class="flex min-h-screen min-w-0 flex-1 flex-col">
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 md:px-10 md:py-10">
      <%- include('flash') %>
<% } else { %>
<body class="flex min-h-screen flex-col pb-28 font-sans md:pb-0">
  <div id="top-loader" class="top-loader" role="progressbar" aria-hidden="true"></div>
  <a href="#main" class="skip-link"><%= t('nav.skip') %></a>

  <%#
    ONE line at every width (pure CSS, no measuring script):
    phones: logo + wordmark | language. md and up: logo | five-item pill menu | language.
    It shrinks instead of wrapping: smaller gaps, then a smaller logo, then fluid text sizes (.header-text, .nav-text).
  %>
  <header class="site-header">
    <div class="topbar">
      <a href="/" class="brand" aria-label="SeniorPadi">
        <span class="brand-mark"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></span>
        <%# the wordmark is the least important item: it hides on tablet widths where the menu needs the room %>
        <span class="brand-word md:max-lg:sr-only">SeniorPadi</span>
      </a>

      <%# on computers the same five-item menu sits in the middle of this one line %>
      <div class="hidden min-w-0 justify-center md:flex md:flex-1"><%- include('seniorNav', { placement: 'top' }) %></div>

      <%# one button that always shows the OTHER language %>
      <form action="/language" method="post" class="shrink-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="back" value="<%= currentPath %>">
        <button name="lang" value="<%= otherLang %>" lang="<%= otherLang %>" class="lang-pill">
          <i class="fa-solid fa-language header-icon max-[359px]:hidden md:max-lg:hidden" aria-hidden="true"></i>
          <%= otherLang === 'yo' ? 'Yorùbá' : 'English' %>
        </button>
      </form>
    </div>
  </header>

  <%# on phones the same menu sits at the bottom of the screen %>
  <div class="md:hidden"><%- include('seniorNav', { placement: 'bottom' }) %></div>

  <main id="main" tabindex="-1" class="<%= isFull ? 'w-full' : (isWide ? 'page-wide' : 'page') %> flex-1">
    <% if (isFull) { %><div class="mx-auto max-w-6xl px-4 pt-4"><%- include('flash') %></div><% } else { %><%- include('flash') %><% } %>
<% } %>
