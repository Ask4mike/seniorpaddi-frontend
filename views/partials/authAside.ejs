<%# left side of the log-in and sign-up pages: reassurance on a soft mint-to-lavender wash (Lightyear, ref 5) %>
<div class="hero-wash relative hidden overflow-hidden p-10 md:flex md:flex-col">
  <p class="mb-5 text-3xl font-bold tracking-tight"><%= t('auth.aside_title') %></p>
  <ul class="mb-8 space-y-3 text-lg">
    <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-1 shrink-0 text-success" aria-hidden="true"></i><span><%= t('home.trust_free') %></span></li>
    <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-1 shrink-0 text-success" aria-hidden="true"></i><span><%= t('home.trust_language') %></span></li>
    <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-1 shrink-0 text-success" aria-hidden="true"></i><span><%= t('home.trust_safe') %></span></li>
  </ul>
  <div class="arch mx-auto mt-auto w-56 bg-surface/70 pt-6">
    <img src="/images/illustrations/elders-chat.svg" alt="" class="mx-auto block w-48" width="192" height="192">
  </div>
</div>
