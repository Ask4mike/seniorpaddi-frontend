<%# left side of the log-in and sign-up pages (decoration and reassurance, solid colour, no movement) %>
<div class="hidden bg-primary p-10 text-white md:flex md:flex-col">
  <p class="mb-4 text-3xl font-bold"><%= t('auth.aside_title') %></p>
  <ul class="mb-8 space-y-3 text-lg text-white">
    <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-1 shrink-0 text-sun" aria-hidden="true"></i><span><%= t('home.trust_free') %></span></li>
    <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-1 shrink-0 text-sun" aria-hidden="true"></i><span><%= t('home.trust_language') %></span></li>
    <li class="flex items-start gap-3"><i class="fa-solid fa-circle-check mt-1 shrink-0 text-sun" aria-hidden="true"></i><span><%= t('home.trust_safe') %></span></li>
  </ul>
  <img src="/images/hero.png" alt="" class="mx-auto mt-auto w-64" width="900" height="1000" aria-hidden="true">
</div>
