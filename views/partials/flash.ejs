<% if (flash) {
     const styles = {
       success: 'alert alert-success',
       error: 'alert alert-error',
       info: 'alert alert-info'
     };
%>
  <div role="<%= flash.type === 'error' ? 'alert' : 'status' %>" class="<%= styles[flash.type] || styles.info %>">
    <i class="fa-solid <%= flash.type === 'success' ? 'fa-circle-check' : (flash.type === 'error' ? 'fa-circle-xmark' : 'fa-circle-info') %> mt-1 shrink-0" aria-hidden="true"></i>
    <span class="min-w-0"><%= flash.message %></span>
  </div>
<% } %>
