<%#
  Sign-up / log-in pop-up. Shown when someone who isn't logged in (or whose session ended)
  taps Register or opens Find seniors. Works without JavaScript.
  needs: heading, mode ('signup' or 'login'), switchHref (same page, other mode),
         registerEventId (optional), next (optional), closeHref
%>
<% const regId = typeof registerEventId !== 'undefined' && registerEventId ? registerEventId : ''; %>
<% const goNext = typeof next !== 'undefined' && next ? next : ''; %>
<% const isSignup = typeof mode !== 'undefined' && mode === 'signup'; %>
<div class="dialog-backdrop" aria-hidden="true"></div>
<div id="login" class="dialog" role="dialog" aria-modal="true" aria-labelledby="login-title" aria-describedby="login-desc" data-dialog>
  <div class="mb-2 flex items-start justify-between gap-4">
    <h2 id="login-title" tabindex="-1"><%= isSignup ? t('modal.title_signup') : heading %></h2>
    <a href="<%= closeHref %>" class="dialog-close" aria-label="<%= t('modal.close') %>" data-dialog-close>&times;</a>
  </div>

  <% if (isSignup) { %>
    <p id="login-desc" class="mb-5"><%= t('modal.signup_note') %></p>
    <form action="/signup" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="registerEventId" value="<%= regId %>">
      <input type="hidden" name="next" value="<%= goNext %>">
      <div class="field">
        <label for="modal-name"><%= t('signup.name') %></label>
        <input type="text" id="modal-name" name="fullName" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="modal-phone"><%= t('signup.phone') %></label>
        <%- include('phoneInput', { id: 'modal-phone', name: 'phone', value: '' }) %>
      </div>
      <div class="field">
        <label for="modal-email"><%= t('signup.email') %></label>
        <input type="email" id="modal-email" name="email" autocomplete="email">
      </div>
      <div class="field">
        <label for="modal-password"><%= t('signup.password') %></label>
        <input type="password" id="modal-password" name="password" autocomplete="new-password" required aria-describedby="modal-password-hint">
        <span class="hint" id="modal-password-hint"><%= t('signup.password_hint') %></span>
      </div>
      <label class="check mb-6">
        <input type="checkbox" name="ageDeclared" value="yes">
        <span><strong><%= t('signup.age') %></strong></span>
      </label>
      <button class="btn btn-block"><%= regId ? t('modal.signup_and_register') : t('signup.submit') %></button>
    </form>
    <p class="mt-5"><%= t('modal.have_account') %> <a href="<%= switchHref %>"><%= t('home.login') %></a></p>

  <% } else { %>
    <p id="login-desc" class="mb-5"><%= t('modal.session_note') %></p>
    <form action="/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="registerEventId" value="<%= regId %>">
      <input type="hidden" name="next" value="<%= goNext %>">
      <div class="field">
        <label for="modal-phone"><%= t('signup.phone') %></label>
        <%- include('phoneInput', { id: 'modal-phone', name: 'phone', value: '' }) %>
      </div>
      <div class="field">
        <label for="modal-password"><%= t('signup.password') %></label>
        <input type="password" id="modal-password" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-block"><%= regId ? t('modal.login_and_register') : t('login.submit') %></button>
    </form>
    <p class="mt-5"><%= t('login.no_account') %> <a href="<%= switchHref %>"><%= t('home.create_account') %></a></p>
    <p class="mt-2"><a href="/forgot-password" class="inline-flex min-h-12 items-center"><%= t('login.forgot') %></a></p>
  <% } %>
</div>
