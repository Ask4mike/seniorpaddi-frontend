<%#
  PasswordInput: a password field with a lock icon and its own show/hide (eye) button.
  Put it inside a .field, after its <label>.
  needs: id. optional: name (leave it out for a field the server must not receive, like "Confirm password"),
         autocomplete, required, describedBy, invalid ('true' / 'false')
  The eye button is hidden until public/js/ui.js wires it up, so without JavaScript nobody sees a button that does nothing.
%>
<div class="input-wrap">
  <span class="input-icon" aria-hidden="true"><i class="fa-solid fa-lock"></i></span>
  <input type="password" id="<%= id %>" class="has-toggle"
         <% if (typeof name !== 'undefined' && name) { %>name="<%= name %>"<% } %>
         <% if (typeof autocomplete !== 'undefined' && autocomplete) { %>autocomplete="<%= autocomplete %>"<% } %>
         <% if (typeof required !== 'undefined' && required) { %>required<% } %>
         <% if (typeof describedBy !== 'undefined') { %>aria-describedby="<%= describedBy %>"<% } %>
         <% if (typeof invalid !== 'undefined') { %>aria-invalid="<%= invalid %>"<% } %>>
  <button type="button" class="input-toggle" data-password-toggle aria-controls="<%= id %>" aria-pressed="false"
          aria-label="<%= t('auth.show_password') %>" data-label-show="<%= t('auth.show_password') %>" data-label-hide="<%= t('auth.hide_password') %>" hidden>
    <i class="fa-solid fa-eye" aria-hidden="true"></i>
  </button>
</div>
