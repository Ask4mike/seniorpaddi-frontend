<%
  // Home, Find events, Find seniors, Messages, My account
  const path = currentPath;
  const items = [
    { href: '/', label: t('nav.home'), icon: 'fa-house', active: path === '/' || path === '/call' || path === '/about' },
    { href: '/events', label: t('nav.find_events'), short: t('nav.events'), icon: 'fa-calendar-days', active: path.startsWith('/events') || path.startsWith('/registrations') },
    { href: '/find-seniors', label: t('nav.find_seniors'), short: t('nav.seniors'), icon: 'fa-user-group', active: path.startsWith('/find-seniors') || path.startsWith('/report') || path.startsWith('/block') },
    { href: '/messages', label: t('nav.messages'), icon: 'fa-comments', active: path.startsWith('/messages') },
    { href: '/account', label: t('nav.account'), icon: 'fa-circle-user', badge: unreadCount, active: ['/account', '/history', '/settings', '/notifications', '/change-password', '/onboarding', '/verify'].some((p) => path.startsWith(p)) }
  ];
  const bottom = placement === 'bottom';
%>
<nav aria-label="Main"
     class="<%= bottom ? 'tabbar' : '' %>">
  <ul class="<%= bottom ? 'flex gap-0 px-0 py-1' : 'flex flex-wrap items-center gap-2' %>">
    <% items.forEach(function (item) { %>
      <li class="<%= bottom ? 'flex-auto' : '' %>">
        <a href="<%= item.href %>" <%= item.active ? 'aria-current=page' : '' %>
           class="<%= bottom ? 'tab-link h-full px-0 text-center leading-tight' : 'nav-link relative' %>">
          <i class="fa-solid <%= item.icon %> <%= bottom ? 'text-xl' : '' %>" aria-hidden="true"></i>
          <span><%= bottom && item.short ? item.short : item.label %></span>
          <% if (item.badge > 0) { %>
            <span class="<%= bottom ? 'absolute right-1 top-1 ' : '' %>min-w-6 rounded-full bg-accent px-1.5 text-center text-sm font-bold text-white"><%= item.badge %></span>
          <% } %>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
