<%- include('../partials/header') %>

<p class="mb-4"><a href="/messages" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><%= t('messages.back') %></a></p>
<h1 class="mb-3"><%= other.firstName() %></h1>

<%# swap phone numbers %>
<div class="mb-6">
  <% if (exchange && exchange.status === 'accepted') { %>
    <p class="panel"><%= t('exchange.their_number', { name: other.firstName() }) %>
      <a href="tel:<%= other.localPhone() %>" class="inline-block py-2 font-bold"><%= other.localPhone() %></a></p>
  <% } else if (exchange && exchange.status === 'pending' && exchange.requesterId === currentUser.id) { %>
    <p class="panel"><%= t('exchange.waiting', { name: other.firstName() }) %></p>
  <% } else if (!incomingRequest) { %>
    <form action="/messages/<%= other.id %>/exchange" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-plain"><%= t('exchange.button') %></button>
    </form>
  <% } %>
</div>

<% if (olderLink) { %><p class="mb-4 text-center"><a href="<%= olderLink %>" class="btn-link"><%= t('messages.older') %></a></p><% } %>

<% if (messages.length === 0) { %>
  <p id="thread-empty" class="panel mb-6"><%= t("messages.start", { name: other.firstName() }) %></p>
<% } %>

<ol id="thread" class="mb-6 space-y-3" aria-label="<%= t('messages.title') %>" aria-live="polite"
    data-me="<%= currentUser.id %>" data-other="<%= other.id %>" data-other-name="<%= other.firstName() %>"
    data-you="<%= t('messages.you') %>" data-just-now="<%= t('messages.just_now') %>">
  <% messages.forEach(function (m) { const mine = m.senderId === currentUser.id; %>
    <li id="msg-<%= m.id %>" class="flex <%= mine ? 'justify-end pl-8 sm:pl-16' : 'justify-start pr-8 sm:pr-16' %>">
      <div class="min-w-0 max-w-full break-words rounded-xl px-4 py-3 <%= mine ? 'bg-primary text-white' : 'bg-surface-muted text-body' %>">
        <p class="sr-only"><%= mine ? t('messages.you') : other.firstName() + ':' %></p>
        <p class="whitespace-pre-line text-base"><%= m.body %></p>
        <p class="mt-1 text-base <%= mine ? 'text-on-primary-muted' : 'text-muted' %>"><%= formatDate(m.createdAt) %>, <%= formatTime(m.createdAt) %></p>
      </div>
    </li>
  <% }) %>
</ol>

<form action="/messages/<%= other.id %>" method="post" id="latest" data-chat-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="body"><%= t('messages.write', { name: other.firstName() }) %></label>
    <textarea id="body" name="body" rows="3" maxlength="1000" required></textarea>
  </div>
  <button class="btn"><%= t('messages.send') %></button>
</form>

<p class="mt-8 flex flex-wrap gap-3 text-base">
  <a href="/report/<%= other.id %>" class="btn-link"><%= t('find.report') %></a>
  <a href="/block/<%= other.id %>" class="btn-link-danger"><%= t('block.link', { name: other.firstName() }) %></a>
</p>

<%# optional: live messages. If these fail to load, the form above still works. %>
<script src="/socket.io/socket.io.js" defer></script>
<script src="/js/chat.js?v=ui1" defer></script>
<% if (incomingRequest) { %>
  <%# pop-up: the other senior asked for their number. No close link: they must answer, so no data-dialog-close %>
  <div class="dialog-backdrop" aria-hidden="true"></div>
  <div role="dialog" aria-modal="true" aria-labelledby="ex-title" aria-describedby="ex-desc" class="dialog" data-dialog>
    <h2 id="ex-title" tabindex="-1" class="mb-2"><%= t('exchange.popup_title', { name: other.firstName() }) %></h2>
    <p id="ex-desc" class="mb-2"><%= t('exchange.popup_text', { name: other.firstName() }) %></p>
    <p class="mb-5 text-base text-muted"><%= t('exchange.safety') %></p>
    <form action="/messages/<%= other.id %>/exchange/accept" method="post" class="mb-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-volunteer btn-block"><%= t('exchange.accept') %></button>
    </form>
    <form action="/messages/<%= other.id %>/exchange/decline" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-plain btn-block"><%= t('exchange.decline') %></button>
    </form>
  </div>
<% } %>

<%- include('../partials/footer') %>
