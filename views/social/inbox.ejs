<%- include('../partials/header') %>

<h1 class="mb-6"><%= t('messages.title') %></h1>

<% if (conversations.length === 0) { %>
  <div class="empty-state">
    <img src="/images/illustrations/messages.svg" alt="" class="empty-art" width="144" height="144">
    <p class="mb-5 text-lg"><%= t('messages.none') %></p>
    <a href="/find-seniors" class="btn btn-lg"><i class="fa-solid fa-user-group" aria-hidden="true"></i><%= t('nav.find') %></a>
  </div>
<% } %>

<%# conversation list (Eldora messages list, ref 8): avatar, name, last message, time, unread dot + word %>
<ul class="space-y-3">
  <% conversations.forEach(function (c) { const unread = unreadIds.has(c.person.id); %>
    <li>
      <a href="/messages/<%= c.person.id %>" class="convo <%= unread ? 'ring-2 ring-primary' : '' %>">
        <span class="avatar h-16 w-16 text-2xl" aria-hidden="true">
          <% if (c.person.profilePictureUrl) { %><img src="<%= c.person.profilePictureUrl %>" alt="" class="h-full w-full object-cover" width="64" height="64"><% } else { %><%= c.person.fullName.charAt(0) %><% } %>
        </span>
        <span class="min-w-0 flex-1">
          <span class="flex flex-wrap items-center justify-between gap-x-3">
            <span class="text-xl font-bold"><%= c.person.firstName() %></span>
            <% if (c.last.createdAt) { %><span class="text-sm text-muted"><%= formatTime(c.last.createdAt) %></span><% } %>
          </span>
          <span class="line-clamp-2 break-words <%= unread ? 'font-semibold text-body' : 'text-muted' %>"><%= c.last.senderId === currentUser.id ? t('messages.you') + ' ' : '' %><%= c.last.body %></span>
          <% if (unread) { %><span class="mt-1 inline-flex items-center gap-2 text-sm font-semibold text-terracotta-700"><span class="unread-dot" aria-hidden="true"></span><%= t('messages.new') %></span><% } %>
        </span>
        <i class="fa-solid fa-chevron-right shrink-0 text-muted" aria-hidden="true"></i>
      </a>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
