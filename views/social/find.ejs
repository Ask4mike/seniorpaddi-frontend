<%- include('../partials/header') %>
<% const status = currentUser ? currentUser.verificationStatus : 'guest'; %>

<div class="mx-auto max-w-xl">

<% if (status === 'approved') { %>
  <div class="mb-5">
    <h1><%= t('find.title') %></h1>
    <p class="text-muted"><%= t('find.subtitle') %></p>
  </div>

  <% if (next) { %>
    <%# one senior at a time: swipe right to message, left to skip %>
    <div class="swipe-stack">
      <div class="swipe-peek card p-0" aria-hidden="true"></div>
      <%# profile: round photo on a soft wash (Fortune circular photo, ref 6), bio under the photo %>
      <article class="swipe-card card overflow-hidden p-0"
               data-swipe-card tabindex="0" aria-label="<%= next.firstName() %>" data-left="skip-senior" data-right="message-senior">
        <div class="hero-wash relative px-6 pt-6 pb-5 text-center">
          <% if (next.profilePictureUrl) { %>
            <img src="<%= next.profilePictureUrl %>" alt="<%= next.firstName() %>" draggable="false" class="mx-auto h-36 w-36 rounded-full object-cover ring-8 ring-surface select-none sm:h-44 sm:w-44" width="176" height="176">
          <% } else { %>
            <div class="mx-auto flex h-36 w-36 items-center justify-center rounded-full bg-primary text-6xl font-bold text-white ring-8 ring-surface sm:h-44 sm:w-44" aria-hidden="true"><%= next.fullName.charAt(0) %></div>
          <% } %>
          <span class="swipe-badge left-4 rounded-full border-4 border-primary bg-surface px-5 py-1 text-xl font-bold text-primary" data-badge="left" aria-hidden="true"><%= t('find.skip') %></span>
          <span class="swipe-badge right-4 rounded-full border-4 border-success bg-success-bg px-5 py-1 text-xl font-bold text-success" data-badge="right" aria-hidden="true"><%= t('find.message_short') %></span>
        </div>
        <div class="px-6 pt-5 pb-6">
          <div class="mb-1 flex flex-wrap items-center justify-center gap-3 text-center">
            <h2 class="text-3xl"><%= next.firstName() %></h2>
            <span class="chip-status chip-verified"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><%= t('find.verified') %></span>
          </div>
          <% if (next.area) { %><p class="mb-4 text-center text-muted"><i class="fa-solid fa-location-dot mr-1" aria-hidden="true"></i><%= next.area %></p><% } %>
          <p class="mb-6 rounded-2xl bg-lavender p-4 text-lg whitespace-pre-line"><%= next.tBio || next.bio || t('find.no_bio') %></p>

          <div class="grid grid-cols-2 gap-3">
            <form id="skip-senior" action="/find-seniors/<%= next.id %>/skip" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn-plain btn-block btn-lg h-full"><i class="fa-solid fa-xmark" aria-hidden="true"></i><%= t('find.skip') %></button>
            </form>
            <a id="message-senior" href="/messages/<%= next.id %>" class="btn btn-block btn-lg h-full"><i class="fa-solid fa-comment-dots" aria-hidden="true"></i><%= t('find.message_short') %></a>
          </div>
        </div>
      </article>
    </div>
    <p class="mt-5 text-center"><a href="/report/<%= next.id %>" class="btn-danger-soft w-auto py-2"><i class="fa-solid fa-flag" aria-hidden="true"></i><%= t('find.report') %></a></p>
  <% } else { %>
    <div class="empty-state">
      <img src="/images/illustrations/elders-chat.svg" alt="" class="empty-art" width="144" height="144">
      <p class="mb-5 text-lg"><%= t('find.seen_everyone') %></p>
      <a href="/messages" class="btn"><i class="fa-solid fa-comments" aria-hidden="true"></i><%= t('find.go_messages') %></a>
    </div>
  <% } %>

<% } else { %>
  <%# locked until the ID is checked %>
  <%# locked until the ID is checked: a reassuring shield, and a status chip with an icon and a word %>
  <div class="mb-6 text-center">
    <img src="/images/illustrations/shield-id.svg" alt="" class="mx-auto mb-4 h-36 w-36" width="144" height="144">
    <h1 class="mb-3"><%= t('find.title') %></h1>
    <% if (status === 'pending') { %>
      <span class="chip-status chip-pending"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i><%= t('find.pending') %></span>
    <% } %>
  </div>

  <% if (status === 'guest') { %>
    <p class="panel text-lg"><%= t('find.why_id') %></p>
    <%- include('../partials/loginModal', {
          heading: t('modal.title_seniors'),
          mode: modalMode,
          switchHref: '/find-seniors?mode=' + (modalMode === 'signup' ? 'login' : 'signup') + '#login',
          next: '/find-seniors',
          closeHref: '/' }) %>

  <% } else if (status === 'pending') { %>
    <div class="empty-state text-left">
      <p class="mb-5 text-lg"><%= t('find.pending_more') %></p>
      <a href="/events" class="btn"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i><%= t('nav.find_events') %></a>
    </div>

  <% } else if (status === 'social_removed') { %>
    <div class="panel">
      <p class="mb-4"><%= t('find.removed') %></p>
      <a href="/events" class="btn"><%= t('nav.find_events') %></a>
    </div>

  <% } else { %>
    <% if (status === 'rejected') { %>
      <div role="alert" class="alert alert-error">
        <i class="fa-solid fa-circle-xmark mt-1" aria-hidden="true"></i>
        <div class="min-w-0">
          <p><%= t('find.rejected') %></p>
          <p class="font-normal"><%= currentUser.verificationRejectionReason %></p>
        </div>
      </div>
    <% } else { %>
      <p class="mb-6"><%= t('find.why_id') %></p>
    <% } %>

    <form action="/find-seniors/id?_csrf=<%= encodeURIComponent(csrfToken) %>" method="post" enctype="multipart/form-data" data-upload>
      <label for="idDocument" class="drop-zone">
        <i class="fa-solid fa-cloud-arrow-up mb-3 text-4xl text-primary" aria-hidden="true"></i>
        <span class="block text-lg font-bold text-primary"><%= t('find.id_label') %></span>
        <span class="mt-1 block text-base text-muted"><%= t('find.id_hint') %></span>
        <input type="file" id="idDocument" name="idDocument" accept="image/jpeg,image/png,application/pdf" class="mx-auto mt-4 block max-w-full text-base file:mr-4 file:min-h-12 file:cursor-pointer file:rounded-xl file:border-0 file:bg-primary file:px-5 file:py-2 file:text-base file:font-bold file:text-white">
      </label>
      <button class="btn-accent btn-block btn-lg" data-uploading-text="<%= t('upload.uploading') %>"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i><%= status === 'rejected' ? t('find.id_resend') : t('find.id_send') %></button>
    </form>
    <p class="mt-4 text-muted"><%= t('find.events_unaffected') %></p>
    <script src="/js/upload.js?v=ui1" defer></script>
  <% } %>
<% } %>

</div>

<%- include('../partials/footer') %>
