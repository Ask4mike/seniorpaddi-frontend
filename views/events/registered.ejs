<%- include('../partials/header') %>

<%# the event stays in the background, the pop-up sits on top %>
<div class="mx-auto max-w-5xl" aria-hidden="true" inert>
  <%- include('../partials/eventCard', { event, showButtons: false }) %>
</div>

<div class="dialog-backdrop" aria-hidden="true"></div>
<div id="done" class="dialog" role="dialog" aria-modal="true" aria-labelledby="done-title" aria-describedby="done-desc" data-dialog>
  <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-success text-white">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
  </div>
  <h1 id="done-title" tabindex="-1" class="mb-2 text-2xl md:text-2xl"><%= t('registered.title') %></h1>
  <div id="done-desc">
    <p class="font-bold"><%= event.tTitle || event.title %></p>
    <p class="mb-3"><%= formatDate(event.startsAt) %>, <%= formatTime(event.startsAt) %></p>
  </div>
  <div class="mb-4 rounded-xl border-2 border-dashed border-primary bg-surface-muted px-4 py-3">
    <p class="text-base text-muted"><%= t('ticket.label') %></p>
    <p class="break-words text-3xl font-bold text-primary"><%= ticket %></p>
    <p class="text-base text-muted"><%= t('ticket.hint') %></p>
  </div>
  <p class="mb-6"><%= currentUser.email ? t('registered.sent_both') : t('registered.sent_sms') %></p>

  <% if (canVolunteer) { %>
    <div class="border-t-2 border-border-strong pt-5">
      <p class="mb-4 text-xl font-bold"><%= t('registered.volunteer_question') %></p>
      <form action="/events/<%= event.id %>/volunteer" method="post" class="mb-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="from" value="popup">
        <button class="btn-volunteer btn-block"><%= t('registered.volunteer_yes') %></button>
      </form>
      <a href="/events" class="btn-plain btn-block"><%= t('registered.volunteer_no') %></a>
    </div>
  <% } else { %>
    <a href="/events" class="btn btn-block"><%= t('registered.continue') %></a>
  <% } %>
  <p class="mt-4"><a href="/account" class="inline-flex min-h-12 items-center"><%= t('registered.see_mine') %></a></p>
</div>

<%- include('../partials/footer') %>
