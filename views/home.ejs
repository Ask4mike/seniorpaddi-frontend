<%- include('partials/header', { pageLayout: 'hero', preloadImage: '/images/events/fitness.webp' }) %>

<%#
  ================= HERO (Xefag product page, ref): one saturated yolk stage, the photo centred like the product,
  big three-line headline on the left, a small info link on the right, and a bottom row:
  trust words | one big number | the white "Find events" pill. It has its own top bar (the same five-item menu). =================
%>
<section class="hero-stage lg:min-h-[min(calc(100dvh-1.5rem),56rem)]" aria-labelledby="hero-title">
  <%# large faint leaf shapes behind the subject (decorative) %>
  <svg class="hero-leaf top-[12%] left-[18%] w-[46vw] max-w-[34rem] -rotate-12" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><path fill="currentColor" d="M100 10c48 30 70 78 50 130-12 32-38 50-50 50s-38-18-50-50C30 88 52 40 100 10z"/></svg>
  <svg class="hero-leaf right-[10%] bottom-[8%] w-[34vw] max-w-[26rem] rotate-[28deg]" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><path fill="currentColor" d="M100 10c48 30 70 78 50 130-12 32-38 50-50 50s-38-18-50-50C30 88 52 40 100 10z"/></svg>

  <%# top bar: logo | the same five-item menu (white pill = this page) | language + account %>
  <div class="hero-bar on-yolk">
    <a href="/" class="brand" aria-label="SeniorPadi">
      <span class="brand-mark"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></span>
      <span class="brand-word md:max-xl:sr-only">SeniorPadi</span>
    </a>
    <div class="hidden min-w-0 justify-center md:flex md:flex-1"><%- include('partials/seniorNav', { placement: 'top' }) %></div>
    <div class="flex shrink-0 items-center gap-2">
      <%- include('partials/langToggle') %>
      <a href="/account" class="icon-round hidden xl:flex" aria-label="<%= t('nav.account') %>"><i class="fa-solid fa-user" aria-hidden="true"></i></a>
    </div>
  </div>

  <div class="relative z-10 grid flex-1 items-center gap-6 px-5 pt-6 pb-4 sm:px-8 lg:grid-cols-[1fr_auto_1fr] lg:gap-8 lg:px-12">
    <div class="min-w-0">
      <span class="glass-chip mb-5"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><%= t('home.eyebrow') %></span>
      <h1 id="hero-title" class="hero-title mb-4 max-w-[13ch]">
        <%= currentUser ? t('home.welcome_back', { name: currentUser.firstName() }) : t('home.hero_title') %>
        <span class="block"><%= t('home.hero_highlight') %></span>
      </h1>
      <p class="measure text-lg text-charcoal/85"><%= t('home.tagline') %></p>
    </div>

    <%# the subject, centred like the product in the reference: arch-cropped photo, soft shadow, a gentle float %>
    <div class="hero-subject">
      <div class="hero-float">
        <div class="arch border-8 border-white/80 shadow-lift">
          <picture>
            <source srcset="/images/events/fitness.webp" type="image/webp">
            <img src="/images/events/fitness.jpg" alt="<%= t('home.hero_photo_alt') %>" class="aspect-[4/5] w-full object-cover" width="720" height="540" fetchpriority="high" decoding="async">
          </picture>
        </div>
      </div>
      <span class="hero-subject-shadow" aria-hidden="true"></span>
    </div>

    <div class="flex lg:justify-end">
      <a href="/about" class="glass-chip min-h-12 no-underline hover:bg-white/70"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><%= t('about.title') %></a>
    </div>
  </div>

  <%# bottom row: trust | big number from the real list of events below | the white pill %>
  <div class="relative z-10 grid items-center gap-5 px-5 pt-2 pb-6 sm:px-8 lg:grid-cols-3 lg:px-12 lg:pb-8">
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-base font-semibold">
      <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-eucalyptus-800" aria-hidden="true"></i><%= t('home.trust_free') %></li>
      <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-eucalyptus-800" aria-hidden="true"></i><%= t('home.trust_language') %></li>
      <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-eucalyptus-800" aria-hidden="true"></i><%= t('home.trust_safe') %></li>
    </ul>
    <p class="flex items-baseline gap-3 lg:justify-center">
      <% if (upcoming.length > 0) { %>
        <span class="text-5xl font-bold tracking-tight md:text-6xl"><%= upcoming.length %></span><span class="text-lg font-semibold"><%= t('home.events_count') %></span>
      <% } else { %>
        <span class="text-5xl font-bold tracking-tight md:text-6xl"><%= t('events.free') %></span>
      <% } %>
    </p>
    <div class="flex lg:justify-end">
      <a href="/events" class="btn-white"><%= t('nav.find_events') %><span class="btn-icon"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
    </div>
  </div>
</section>

<%# ================= THE THREE CHOICES (Eldora tiles, ref 8). Call uses the yolk accent ================= %>
<section class="mx-auto max-w-6xl px-4 pt-6 pb-6 md:pt-10" aria-labelledby="what-title">
  <h2 id="what-title" class="mb-1"><%= t('home.what_kicker') %></h2>
  <p class="mb-5 text-lg text-muted"><%= t('home.what_title') %></p>
  <ul class="tile-list grid gap-4 md:grid-cols-3 md:gap-6">
    <% [
         { href: '/events', art: 'elders-exercise', title: t('nav.find_events'), text: t('home.card_events'), accent: false },
         { href: '/find-seniors', art: 'elders-chat', title: t('nav.find_seniors'), text: t('home.card_seniors'), accent: false },
         { href: '/call', art: 'phone-call', title: t('call.title'), text: t('home.card_call'), accent: true }
       ].forEach(function (card) { %>
      <li>
        <a href="<%= card.href %>" class="tile h-full <%= card.accent ? 'tile-accent' : '' %>">
          <span class="tile-art"><img src="/images/illustrations/<%= card.art %>.svg" alt="" class="h-full w-full" width="112" height="112"></span>
          <span class="flex min-w-0 flex-1 flex-col gap-1">
            <span class="text-2xl font-bold tracking-tight"><%= card.title %></span>
            <span class="text-base <%= card.accent ? 'text-charcoal' : 'text-muted' %>"><%= card.text %></span>
          </span>
          <span class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full <%= card.accent ? 'bg-charcoal text-yolk-400' : 'bg-primary text-white' %> sm:flex md:mt-auto md:self-end" aria-hidden="true">
            <i class="fa-solid fa-arrow-right"></i>
          </span>
        </a>
      </li>
    <% }) %>
  </ul>
</section>

<%# ================= EVENTS NEAR YOU: tall photo cards (profile-card refs) in a product-style grid (Gozney ref) ================= %>
<section class="mx-auto max-w-6xl px-4 py-10" aria-labelledby="upcoming-title">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="kicker"><%= t('home.upcoming_kicker') %></p>
      <h2 id="upcoming-title"><%= t('home.upcoming_title') %></h2>
    </div>
    <a href="/events" class="btn-white"><%= t('home.see_all') %><span class="btn-icon"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a>
  </div>
  <% if (upcoming.length > 0) { %>
    <%# the cards alternate between the dark glass look and the light look %>
    <ul class="ev-grid">
      <% upcoming.forEach(function (event, i) { %>
        <li><%- include('partials/eventTile', { event, variant: i % 2 === 0 ? 'dark' : 'light' }) %></li>
      <% }) %>
    </ul>
  <% } else { %>
    <%# nothing planned yet: a friendly note and one way forward %>
    <div class="empty-state">
      <img src="/images/illustrations/calendar.svg" alt="" class="empty-art" width="144" height="144" loading="lazy">
      <p class="mb-5 text-lg"><%= t('stack.none') %></p>
      <a href="/events" class="btn btn-lg"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><%= t('nav.find_events') %></a>
    </div>
  <% } %>
</section>

<%# ================= HOW IT WORKS ================= %>
<section class="mx-auto max-w-6xl px-4 py-10" aria-labelledby="how-title">
  <div class="grid items-center gap-8 rounded-4xl bg-surface p-6 shadow-soft md:grid-cols-5 md:p-10">
    <div class="min-w-0 md:col-span-3">
      <p class="kicker"><%= t('home.how_kicker') %></p>
      <h2 id="how-title" class="mb-6"><%= t('home.how_title') %></h2>
      <ol class="space-y-4">
        <% [['fa-user-plus', t('home.step1')], ['fa-hand-pointer', t('home.step2')], ['fa-message', t('home.step3')]].forEach(function (step, i) { %>
          <li class="flex gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-lg font-bold text-white" aria-hidden="true"><%= i + 1 %></span>
            <span class="min-w-0 pt-2 text-lg"><i class="fa-solid <%= step[0] %> mr-2 text-primary" aria-hidden="true"></i><%= step[1] %></span>
          </li>
        <% }) %>
      </ol>
    </div>
    <div class="hidden md:col-span-2 md:block" aria-hidden="true">
      <div class="arch mx-auto w-60 bg-lavender pt-8"><img src="/images/illustrations/calendar.svg" alt="" class="mx-auto block w-52" width="208" height="208" loading="lazy"></div>
    </div>
  </div>
</section>

<%# ================= VOLUNTEER (Fortune peach warmth, ref 6) + FAMILY ================= %>
<section class="mx-auto max-w-6xl px-4 pb-6">
  <div class="grid gap-4 md:grid-cols-2 md:gap-6">
    <div class="hero-warm flex flex-col rounded-4xl p-6 md:p-8">
      <img src="/images/illustrations/volunteer.svg" alt="" class="mb-4 h-20 w-20" width="80" height="80" loading="lazy">
      <h2 class="mb-3"><%= t('home.volunteer_title') %></h2>
      <p class="measure mb-6 text-lg"><%= t('home.volunteer_text') %></p>
      <a href="/events" class="btn-volunteer mt-auto self-start"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i><%= t('nav.find_events') %></a>
    </div>
    <div class="flex flex-col rounded-4xl bg-lavender p-6 md:p-8">
      <img src="/images/illustrations/phone-call.svg" alt="" class="mb-4 h-20 w-20" width="80" height="80" loading="lazy">
      <h2 class="mb-3"><%= t('home.family_title') %></h2>
      <p class="measure mb-6 text-lg"><%= t('home.family_text') %></p>
      <a href="/call" class="btn-plain mt-auto self-start"><i class="fa-solid fa-phone" aria-hidden="true"></i><%= t('call.title') %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
