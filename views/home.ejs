<%- include('partials/header') %>

<%# ================= HERO ================= %>
<section>
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 md:grid-cols-2 md:py-20">
    <div class="min-w-0">
      <span class="mb-5 inline-flex items-center gap-2 rounded-full bg-surface-muted px-4 py-2 text-base font-bold text-primary">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i><%= t('home.eyebrow') %>
      </span>
      <h1 class="mb-5 text-4xl font-bold md:text-5xl">
        <%= currentUser ? t('home.welcome_back', { name: currentUser.firstName() }) : t('home.hero_title') %>
        <span class="block text-primary"><%= t('home.hero_highlight') %></span>
      </h1>
      <p class="measure mb-8 text-lg text-muted"><%= t('home.tagline') %></p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/events" class="btn"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><%= t('nav.find_events') %></a>
        <a href="/find-seniors" class="btn-plain"><i class="fa-solid fa-user-group" aria-hidden="true"></i><%= t('nav.find_seniors') %></a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-base text-muted">
        <li><i class="fa-solid fa-circle-check mr-2 text-success" aria-hidden="true"></i><%= t('home.trust_free') %></li>
        <li><i class="fa-solid fa-circle-check mr-2 text-success" aria-hidden="true"></i><%= t('home.trust_language') %></li>
        <li><i class="fa-solid fa-circle-check mr-2 text-success" aria-hidden="true"></i><%= t('home.trust_safe') %></li>
      </ul>
    </div>

    <div>
      <img src="/images/hero.png" alt="<%= t('home.hero_alt') %>" class="mx-auto w-full max-w-md drop-shadow-xl" width="900" height="1000">
    </div>
  </div>
</section>

<%# ================= THREE THINGS YOU CAN DO ================= %>
<section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="what-title">
  <div class="mb-8 max-w-xl">
    <p class="kicker"><%= t('home.what_kicker') %></p>
    <h2 id="what-title" class="text-2xl md:text-3xl"><%= t('home.what_title') %></h2>
  </div>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <% [
         { href: '/events', icon: 'fa-calendar-days', title: t('nav.find_events'), text: t('home.card_events'), style: 'bg-primary text-white hover:bg-primary-dark', iconBg: 'bg-primary-dark text-white' },
         { href: '/find-seniors', icon: 'fa-user-group', title: t('nav.find_seniors'), text: t('home.card_seniors'), style: 'bg-surface border-2 border-border-strong text-body hover:bg-surface-muted', iconBg: 'bg-surface-muted text-primary' },
         { href: '/call', icon: 'fa-phone-volume', title: t('call.title'), text: t('home.card_call'), style: 'bg-accent text-white hover:bg-accent-dark', iconBg: 'bg-accent-dark text-white' }
       ].forEach(function (card, i) { %>
      <a href="<%= card.href %>"
         class="flex flex-col gap-4 rounded-2xl p-7 no-underline transition-colors <%= card.style %>">
        <span class="flex h-14 w-14 items-center justify-center rounded-xl text-2xl <%= card.iconBg %>"><i class="fa-solid <%= card.icon %>" aria-hidden="true"></i></span>
        <span class="text-xl font-bold"><%= card.title %></span>
        <span class="text-lg <%= i === 0 ? 'text-on-primary-muted' : '' %>"><%= card.text %></span>
        <span class="mt-auto inline-flex items-center gap-2 text-lg font-bold underline decoration-2 underline-offset-4"><%= t('home.open') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
      </a>
    <% }) %>
  </div>
</section>

<%# ================= COMING UP ================= %>
<% if (upcoming.length > 0) { %>
<section class="bg-surface-muted py-14" aria-labelledby="upcoming-title">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker"><%= t('home.upcoming_kicker') %></p>
        <h2 id="upcoming-title" class="text-2xl md:text-3xl"><%= t('home.upcoming_title') %></h2>
      </div>
      <a href="/events" class="btn-plain"><%= t('home.see_all') %><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      <% upcoming.forEach(function (event, i) { %>
        <a href="/events/<%= event.id %>"
           class="flex flex-col overflow-hidden rounded-2xl border-2 border-gray-200 bg-surface text-body no-underline shadow-sm transition-colors hover:bg-surface-subtle sm:flex-row">
          <%- include('partials/eventImage', { event, imgClass: 'h-40 w-full shrink-0 object-cover sm:h-auto sm:w-44' }) %>
          <span class="flex min-w-0 flex-col justify-center gap-2 break-words p-5">
            <span class="tag-mine self-start"><i class="fa-solid fa-tag" aria-hidden="true"></i><%= t('category.' + event.category) %></span>
            <span class="text-xl font-bold"><%= event.tTitle || event.title %></span>
            <span class="text-base text-muted"><i class="fa-regular fa-calendar mr-2" aria-hidden="true"></i><%= formatDate(event.startsAt) %>, <%= formatTime(event.startsAt) %></span>
            <span class="text-base text-muted"><i class="fa-solid fa-location-dot mr-2" aria-hidden="true"></i><%= event.locationText %></span>
          </span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%# ================= HOW IT WORKS ================= %>
<section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-2" aria-labelledby="how-title">
  <div class="order-last grid grid-cols-2 gap-4 md:order-first" aria-hidden="true">
    <img src="/images/events/fitness.jpg" alt="" class="rounded-2xl" width="800" height="600">
    <img src="/images/events/skills.jpg" alt="" class="mt-10 rounded-2xl" width="800" height="600">
    <img src="/images/events/social.jpg" alt="" class="-mt-6 rounded-2xl" width="800" height="600">
    <img src="/images/events/faith.jpg" alt="" class="mt-4 rounded-2xl" width="800" height="600">
  </div>
  <div class="min-w-0">
    <p class="kicker"><%= t('home.how_kicker') %></p>
    <h2 id="how-title" class="mb-6 text-2xl md:text-3xl"><%= t('home.how_title') %></h2>
    <ol class="space-y-5">
      <% [['fa-user-plus', t('home.step1')], ['fa-hand-pointer', t('home.step2')], ['fa-message', t('home.step3')]].forEach(function (step, i) { %>
        <li class="flex gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary text-lg text-white"><i class="fa-solid <%= step[0] %>" aria-hidden="true"></i></span>
          <span class="min-w-0 pt-2 text-lg"><span class="mr-1 font-bold text-primary"><%= i + 1 %>.</span><%= step[1] %></span>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<%# ================= VOLUNTEER + CALL ================= %>
<section class="mx-auto max-w-6xl px-4 pb-6">
  <div class="grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl bg-success p-8 text-white">
      <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-success-dark text-2xl text-white"><i class="fa-solid fa-hands-holding-circle" aria-hidden="true"></i></span>
      <h2 class="mb-3"><%= t('home.volunteer_title') %></h2>
      <p class="measure mb-6 text-lg"><%= t('home.volunteer_text') %></p>
      <a href="/events" class="btn-plain focus-visible:outline-focus-on-dark"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i><%= t('nav.find_events') %></a>
    </div>
    <div class="rounded-2xl bg-accent p-8 text-white">
      <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-accent-dark text-2xl text-white"><i class="fa-solid fa-phone-volume" aria-hidden="true"></i></span>
      <h2 class="mb-3"><%= t('home.family_title') %></h2>
      <p class="measure mb-6 text-lg"><%= t('home.family_text') %></p>
      <a href="/call" class="btn-plain focus-visible:outline-focus-on-dark"><i class="fa-solid fa-phone" aria-hidden="true"></i><%= t('call.title') %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
