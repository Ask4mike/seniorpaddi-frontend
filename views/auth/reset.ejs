<%- include('../partials/header') %>

<div class="mx-auto grid max-w-4xl overflow-hidden rounded-3xl border-2 border-gray-200 bg-surface md:grid-cols-2">
  <%- include('../partials/authAside') %>
  <div class="min-w-0 p-6 sm:p-10">
    <h1 class="mb-6"><%= t('reset.title') %></h1>
    <% if (error) { %>
      <div role="alert" class="alert alert-error"><i class="fa-solid fa-circle-xmark mt-1 shrink-0" aria-hidden="true"></i><span><%= error %></span></div>
    <% } %>

    <form action="<%= action %>" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="password"><%= t('reset.new_password') %></label>
        <input type="password" id="password" name="password" autocomplete="new-password" required aria-describedby="password-hint">
        <span class="hint" id="password-hint"><%= t('signup.password_hint') %></span>
      </div>
      <button class="btn btn-block"><%= t('reset.submit') %></button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
