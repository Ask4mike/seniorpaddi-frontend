<%- include('../partials/header') %>

<div class="mx-auto grid max-w-4xl overflow-hidden rounded-4xl bg-surface shadow-soft md:grid-cols-2">
  <%- include('../partials/authAside') %>
  <div class="min-w-0 p-6 sm:p-10">
    <h1 class="mb-4"><%= t('forgot.title') %></h1>

    <% if (sent) { %>
      <div class="panel">
        <p class="mb-3"><%= t('forgot.sent_email') %></p>
        <p><%= t('forgot.sent_no_email', { phone: supportPhone }) %></p>
      </div>
      <p class="mt-6"><a href="/login" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><%= t('forgot.back') %></a></p>
    <% } else { %>
      <p class="mb-6"><%= t('forgot.intro') %></p>
      <form action="/forgot-password" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="phone"><%= t('signup.phone') %></label>
          <%- include('../partials/phoneInput', { id: 'phone', name: 'phone', value: '' }) %>
        </div>
        <button class="btn btn-block"><%= t('forgot.submit') %></button>
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
