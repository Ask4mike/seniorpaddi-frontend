<%- include('../partials/header') %>

<div class="auth-shell">
  <%- include('../partials/authAside') %>
  <div class="auth-panel">
    <span class="auth-mobile-mark" aria-hidden="true"><i class="fa-solid fa-hand-holding-heart"></i></span>
    <h1 class="auth-title text-center md:text-left"><%= t('login.title') %></h1>
    <%# on phones the friendly panel is hidden, so its headline appears here instead %>
    <p class="auth-lede text-center md:hidden"><%= t('auth.aside_title') %></p>

    <% if (error) { %>
      <div role="alert" class="alert alert-error"><i class="fa-solid fa-circle-xmark mt-1 shrink-0" aria-hidden="true"></i><span><%= error %></span></div>
    <% } %>

    <form action="/login" method="post" class="form-soft" data-busy-text="<%= t('auth.logging_in') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="registerEventId" value="<%= typeof after !== 'undefined' ? after.registerEventId : '' %>">
      <input type="hidden" name="next" value="<%= typeof after !== 'undefined' ? after.next : '' %>">

      <div class="field">
        <label for="phone"><%= t('signup.phone') %></label>
        <div class="input-wrap">
          <span class="input-icon" aria-hidden="true"><i class="fa-solid fa-phone"></i></span>
          <%- include('../partials/phoneInput', { id: 'phone', name: 'phone', value: phone }) %>
        </div>
      </div>

      <div class="field">
        <%# the forgot link sits on the label line (children's stories ref), so it is found right where it is needed %>
        <div class="label-row">
          <label for="password"><%= t('signup.password') %></label>
          <a href="/forgot-password" class="inline-flex min-h-12 items-center text-base font-semibold"><%= t('login.forgot') %></a>
        </div>
        <%- include('../partials/ui/passwordInput', { id: 'password', name: 'password', autocomplete: 'current-password', required: true }) %>
      </div>

      <button class="btn btn-block btn-lg"><%= t('login.submit') %></button>
    </form>

    <p class="auth-switch"><%= t('login.no_account') %> <a href="/signup<%= typeof after !== 'undefined' && after.registerEventId ? '?register=' + after.registerEventId : '' %>" class="inline-flex min-h-12 items-center font-semibold"><%= t('home.create_account') %></a></p>
  </div>
</div>

<%- include('../partials/footer') %>
