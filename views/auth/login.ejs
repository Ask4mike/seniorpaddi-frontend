<%- include('../partials/header', { pageLayout: 'auth' }) %>

<%# "Welcome Back" layout (ref): mesh-gradient art panel | frosted form card + social-proof strip. Fits the screen from 1024px %>
<div class="auth-frame">
  <section class="auth-art" aria-labelledby="login-art-title">
    <span class="auth-bigword" aria-hidden="true"><%= t('auth.big_word') %></span>
    <span class="auth-orb" aria-hidden="true"></span>
    <div class="relative max-w-md">
      <p id="login-art-title" class="mb-2 text-3xl leading-tight font-bold tracking-tight"><%= t('auth.aside_title') %></p>
      <p class="text-lg text-slate-muted"><%= t('home.tagline') %></p>
    </div>
  </section>

  <div class="auth-side">
    <div class="auth-card">
      <div class="auth-card-inner">
        <div class="mb-4 flex items-center justify-between gap-3">
          <a href="/" class="logo-tile" aria-label="SeniorPadi"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></a>
          <%- include('../partials/langToggle') %>
        </div>
        <h1 class="mb-1 text-3xl md:text-4xl"><%= t('auth.welcome_back') %></h1>
        <p class="mb-5 text-lg text-muted"><%= t('auth.welcome_sub') %></p>

        <%- include('../partials/flash') %>
        <% if (error) { %>
          <div role="alert" class="alert alert-error"><i class="fa-solid fa-circle-xmark mt-1 shrink-0" aria-hidden="true"></i><span><%= error %></span></div>
        <% } %>

        <form action="/login" method="post" class="form-soft form-compact" data-busy-text="<%= t('auth.logging_in') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="registerEventId" value="<%= typeof after !== 'undefined' ? after.registerEventId : '' %>">
          <input type="hidden" name="next" value="<%= typeof after !== 'undefined' ? after.next : '' %>">

          <div class="field">
            <label for="phone"><%= t('signup.phone') %></label>
            <div class="input-wrap">
              <span class="input-icon" aria-hidden="true"><i class="fa-solid fa-phone"></i></span>
              <%- include('../partials/phoneInput', { id: 'phone', name: 'phone', value: phone }) %>
            </div>
          </div>

          <div class="field">
            <div class="label-row">
              <label for="password"><%= t('signup.password') %></label>
              <%# still a 48px target, without making the label line taller %>
              <a href="/forgot-password" class="-my-3 inline-flex min-h-12 items-center text-base font-semibold"><%= t('login.forgot') %></a>
            </div>
            <%- include('../partials/ui/passwordInput', { id: 'password', name: 'password', autocomplete: 'current-password', required: true }) %>
          </div>

          <button class="btn-glow mt-1"><%= t('login.submit') %></button>
        </form>

        <p class="mt-3 text-center text-lg"><%= t('login.no_account') %> <a href="/signup<%= typeof after !== 'undefined' && after.registerEventId ? '?register=' + after.registerEventId : '' %>" class="inline-flex min-h-12 items-center font-semibold"><%= t('home.create_account') %></a></p>
      </div>
    </div>

    <%# social-proof strip (ref): initials stand in for members; no invented numbers %>
    <div class="auth-strip">
      <span class="avatar-stack" aria-hidden="true">
        <span class="bg-yolk-400 text-charcoal">A</span><span class="bg-eucalyptus-700 text-white">B</span><span class="bg-primary text-white">F</span>
      </span>
      <span class="min-w-0">
        <span class="flex items-center gap-2 text-lg font-bold"><i class="fa-solid fa-shield-halved text-success" aria-hidden="true"></i><%= t('auth.trust_title') %></span>
        <span class="block text-base text-muted"><%= t('auth.trust_text') %></span>
      </span>
    </div>
  </div>
</div>

<%- include('../partials/footer', { pageLayout: 'auth' }) %>
