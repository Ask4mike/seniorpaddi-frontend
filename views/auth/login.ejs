<%- include('../partials/header') %>

<div class="mx-auto grid max-w-4xl overflow-hidden rounded-3xl border-2 border-gray-200 bg-surface md:grid-cols-2">
  <%- include('../partials/authAside') %>
  <div class="min-w-0 p-6 sm:p-10">
    <h1 class="mb-6"><%= t('login.title') %></h1>

    <% if (error) { %>
      <div role="alert" class="alert alert-error"><i class="fa-solid fa-circle-xmark mt-1 shrink-0" aria-hidden="true"></i><span><%= error %></span></div>
    <% } %>

    <form action="/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="registerEventId" value="<%= typeof after !== 'undefined' ? after.registerEventId : '' %>">
      <input type="hidden" name="next" value="<%= typeof after !== 'undefined' ? after.next : '' %>">

      <div class="field">
        <label for="phone"><%= t('signup.phone') %></label>
        <%- include('../partials/phoneInput', { id: 'phone', name: 'phone', value: phone }) %>
      </div>

      <div class="field">
        <label for="password"><%= t('signup.password') %></label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>

      <button class="btn btn-block"><%= t('login.submit') %></button>
    </form>

    <p class="mt-6"><a href="/forgot-password" class="inline-flex min-h-12 items-center"><%= t('login.forgot') %></a></p>
    <p class="mt-2 flex flex-wrap items-center gap-x-2"><%= t('login.no_account') %> <a href="/signup<%= typeof after !== 'undefined' && after.registerEventId ? '?register=' + after.registerEventId : '' %>" class="inline-flex min-h-12 items-center"><%= t('home.create_account') %></a></p>
  </div>
</div>

<%- include('../partials/footer') %>
