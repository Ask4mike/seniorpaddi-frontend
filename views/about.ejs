<%- include('partials/header') %>
<% const tel = (supportPhone || '').replace(/[^\d+]/g, ''); %>

<section class="mb-10 grid items-center gap-8 md:grid-cols-2">
  <div class="min-w-0">
    <p class="kicker"><i class="fa-solid fa-circle-info mr-2" aria-hidden="true"></i><%= t('about.title') %></p>
    <h1 class="mb-4"><%= t('about.intro') %></h1>
  </div>
  <img src="/images/hero.png" alt="" class="mx-auto w-72 max-w-full drop-shadow-xl" width="900" height="1000" aria-hidden="true">
</section>

<div class="grid gap-6 md:grid-cols-2">
  <section class="card">
    <span class="icon-tile mb-4 flex"><i class="fa-solid fa-heart" aria-hidden="true"></i></span>
    <h2 class="mb-2"><%= t('about.why_title') %></h2>
    <p class="text-muted"><%= t('about.why_text') %></p>
  </section>

  <section class="card">
    <span class="icon-tile mb-4 flex"><i class="fa-solid fa-route" aria-hidden="true"></i></span>
    <h2 class="mb-2"><%= t('about.how_title') %></h2>
    <ul class="space-y-2 text-muted">
      <li><i class="fa-solid fa-check mr-2 text-success" aria-hidden="true"></i><%= t('about.how_1') %></li>
      <li><i class="fa-solid fa-check mr-2 text-success" aria-hidden="true"></i><%= t('about.how_2') %></li>
      <li><i class="fa-solid fa-check mr-2 text-success" aria-hidden="true"></i><%= t('about.how_3') %></li>
    </ul>
  </section>

  <section class="card">
    <span class="icon-tile mb-4 flex"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i></span>
    <h2 class="mb-2"><%= t('about.safety_title') %></h2>
    <p class="text-muted"><%= t('about.safety_text') %></p>
  </section>

  <section class="panel">
    <span class="icon-tile mb-4 flex bg-surface text-primary"><i class="fa-solid fa-phone-volume" aria-hidden="true"></i></span>
    <h2 class="mb-2"><%= t('about.contact_title') %></h2>
    <p class="mb-5 text-muted"><%= t('about.contact_text') %></p>
    <% if (tel) { %><a href="tel:<%= tel %>" class="btn-coral"><i class="fa-solid fa-phone" aria-hidden="true"></i><%= t('call.call_now', { phone: supportPhone }) %></a><% } %>
  </section>
</div>

<%- include('partials/footer') %>
