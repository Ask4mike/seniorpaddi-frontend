<%- include('../partials/header') %>
<%
  const statCards = [
    { key: 'events', label: 'Events listed', icon: 'fa-calendar-days', color: 'bg-primary text-white' },
    { key: 'registrations', label: 'Registrations', icon: 'fa-ticket', color: 'bg-accent text-white' },
    { key: 'attendees', label: 'Attendees', icon: 'fa-user-check', color: 'bg-success text-white' },
    { key: 'seniors', label: 'Seniors signed up', icon: 'fa-users', color: 'bg-secondary text-white' }
  ];
  const maxDay = Math.max(1, ...stats.days.map((d) => d.total));
  const maxCat = Math.max(1, ...stats.categories.map((c) => c.total));
  const catIcons = { fitness: 'fa-person-walking', faith: 'fa-hands-praying', learning: 'fa-book-open-reader', skills: 'fa-palette', social: 'fa-people-group', health: 'fa-heart-pulse' };
  const startupWarnings = typeof systemWarnings !== 'undefined' ? systemWarnings : [];
%>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-muted">Welcome back, <%= currentUser.firstName() %></p>
    <h1>Dashboard</h1>
  </div>
  <div class="flex flex-wrap gap-3">
    <a href="/admin/events/new" class="btn"><i class="fa-solid fa-plus" aria-hidden="true"></i>New event</a>
    <a href="/admin/organizations" class="btn-plain"><i class="fa-solid fa-building" aria-hidden="true"></i>Organizations</a>
  </div>
</div>

<% if (startupWarnings.length > 0) { %>
  <a href="/admin/system" class="alert alert-warning min-h-12 items-center">
    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <span><strong><%= startupWarnings.length %> setting(s)</strong> need attention. Open System to see which.</span>
  </a>
<% } %>

<%# ---------- the big numbers (refresh themselves every 20 seconds; not announced, they are bare numbers) ---------- %>
<div id="live-stats" class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-live="off">
  <% statCards.forEach(function (card) { %>
    <div class="card">
      <div class="mb-3 flex items-center justify-between gap-3">
        <span class="min-w-0 text-base text-muted"><%= card.label %></span>
        <span class="icon-tile <%= card.color %>"><i class="fa-solid <%= card.icon %>" aria-hidden="true"></i></span>
      </div>
      <p class="text-4xl font-bold leading-none" data-stat="<%= card.key %>"><%= stats.totals[card.key] %></p>
    </div>
  <% }) %>
</div>

<div class="mb-8 grid gap-6 lg:grid-cols-3">
  <%# ---------- registrations over the last 14 days ---------- %>
  <section class="card lg:col-span-2">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl">Registrations, last 14 days</h2>
      <span class="text-sm text-muted"><i class="fa-solid fa-rotate mr-1" aria-hidden="true"></i><span id="stats-updated">Live</span></span>
    </div>
    <div id="day-chart" class="flex h-48 items-end gap-1.5" role="img" aria-label="Registrations per day for the last 14 days">
      <% stats.days.forEach(function (d) { %>
        <div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end gap-1" title="<%= d.label %>: <%= d.total %>">
          <span class="text-sm text-muted" data-day-total="<%= d.key %>"><%= d.total || '' %></span>
          <div class="w-full rounded-t-lg bg-primary" data-day-bar="<%= d.key %>" style="height: <%= Math.max(4, Math.round((d.total / maxDay) * 100)) %>%"></div>
        </div>
      <% }) %>
    </div>
    <div class="mt-2 flex justify-between gap-3 text-sm text-muted">
      <span><%= stats.days[0].label %></span><span>Today</span>
    </div>
  </section>

  <%# ---------- attendance rate + by type ---------- %>
  <section class="card">
    <h2 class="mb-4 text-xl">Attendance</h2>
    <div class="mb-6 flex items-center gap-4">
      <div class="relative h-24 w-24 shrink-0 rounded-full" id="rate-ring"
           style="background: conic-gradient(var(--color-mint) <%= stats.totals.attendanceRate %>%, #eef2fa 0)">
        <div class="absolute inset-2.5 flex items-center justify-center rounded-full bg-surface text-xl font-bold" data-stat="attendanceRate-label"><%= stats.totals.attendanceRate %>%</div>
      </div>
      <p class="min-w-0 text-base text-muted">of people registered for past events actually came.</p>
    </div>
    <h3 class="mb-3 text-lg text-muted">Registrations by type</h3>
    <ul class="space-y-3">
      <% stats.categories.forEach(function (c) { %>
        <li>
          <div class="mb-1 flex justify-between gap-3 text-base"><span><i class="fa-solid <%= catIcons[c.category] || 'fa-tag' %> mr-2 text-primary" aria-hidden="true"></i><%= t('category.' + c.category) %></span><span class="text-muted"><%= c.total %></span></div>
          <div class="h-3 overflow-hidden rounded-full border-2 border-border-strong bg-surface-muted"><div class="h-full rounded-full bg-primary" style="width: <%= Math.round((c.total / maxCat) * 100) %>%"></div></div>
        </li>
      <% }) %>
      <% if (stats.categories.length === 0) { %><li class="text-muted">No registrations yet.</li><% } %>
    </ul>
  </section>
</div>

<%# ---------- things to do ---------- %>
<div class="mb-8 grid gap-4 md:grid-cols-2">
  <a href="/admin/ids" class="card flex items-center gap-4 text-body no-underline transition-colors hover:bg-surface-muted">
    <span class="icon-tile <%= pendingIds > 0 ? 'bg-warning-bg text-warning-ink' : 'bg-surface-muted text-primary' %>"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
    <span><span class="block text-2xl font-bold"><%= pendingIds %></span><span class="text-muted underline decoration-2 underline-offset-4">ID(s) waiting to be checked</span></span>
  </a>
  <a href="/admin/reports" class="card flex items-center gap-4 text-body no-underline transition-colors hover:bg-surface-muted">
    <span class="icon-tile <%= openReports > 0 ? 'bg-accent text-white' : 'bg-surface-muted text-primary' %>"><i class="fa-solid fa-flag" aria-hidden="true"></i></span>
    <span><span class="block text-2xl font-bold"><%= openReports %></span><span class="text-muted underline decoration-2 underline-offset-4">open report(s)</span></span>
  </a>
</div>

<% if (alerts.length > 0) { %>
  <section class="card mb-8">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl"><i class="fa-solid fa-bell mr-2 text-primary" aria-hidden="true"></i>New alerts</h2>
      <form action="/admin/alerts/read" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn-link">Mark all as seen</button>
      </form>
    </div>
    <ul class="divide-y divide-gray-200">
      <% alerts.forEach(function (a) { %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-2"><span class="min-w-0"><%= t('notification.' + a.type, a.payload) %></span><% if (a.link) { %><a href="<%= a.link %>" class="btn-link shrink-0">Open</a><% } %></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<%# ---------- next two weeks ---------- %>
<section class="card mb-8">
  <h2 id="upcoming-title" class="mb-4 text-xl">Next 14 days</h2>
  <% if (upcoming.length === 0) { %>
    <p class="text-muted">No events in the next two weeks. <a href="/admin/events/new">Add one</a></p>
  <% } else { %>
    <div class="table-wrap" role="region" aria-labelledby="upcoming-title" tabindex="0">
      <table class="admin-table" aria-labelledby="upcoming-title">
        <thead><tr><th scope="col">Event</th><th scope="col">When</th><th scope="col">Places taken</th><th scope="col">Volunteers</th><td></td></tr></thead>
        <tbody>
          <% upcoming.forEach(function (event) { const pct = Math.min(100, Math.round((event.taken / event.capacity) * 100)); %>
            <tr>
              <td><span class="font-bold"><%= event.title %></span><br><span class="text-sm text-muted"><%= event.Organization.name %></span></td>
              <td><%= formatDate(event.startsAt) %><br><span class="text-sm text-muted"><%= formatTime(event.startsAt) %></span></td>
              <td class="min-w-36">
                <span class="text-base"><%= event.taken %> / <%= event.capacity %></span>
                <div class="mt-1 h-3 overflow-hidden rounded-full border-2 border-border-strong bg-surface-muted"><div class="h-full rounded-full <%= pct >= 90 ? 'bg-accent' : 'bg-primary' %>" style="width: <%= pct %>%"></div></div>
              </td>
              <td><%= event.volunteerEnabled ? event.volunteersTaken + ' / ' + event.volunteerCapacity : '–' %></td>
              <td><a href="/admin/events/<%= event.id %>/attendance" class="btn-link whitespace-nowrap"><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>Attendance</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<div class="grid gap-6 xl:grid-cols-2">
  <section class="card">
    <h2 class="mb-3 text-xl">Attendance still to enter</h2>
    <% if (needsAttendance.length === 0) { %>
      <p class="text-muted"><i class="fa-solid fa-circle-check mr-1 text-success" aria-hidden="true"></i>All caught up.</p>
    <% } else { %>
      <ul class="space-y-1">
        <% needsAttendance.forEach(function (event) { %>
          <li><a href="/admin/events/<%= event.id %>/attendance" class="inline-flex min-h-12 items-center"><%= event.title %></a> <span class="text-muted">(<%= formatDate(event.startsAt) %>), <%= event.Registrations.length %> not marked</span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <h2 id="missed-title" class="mb-1 text-xl">Missed events</h2>
    <p class="mb-3 text-base text-muted">For a friendly follow-up call. Nothing happens automatically.</p>
    <% if (noShows.length === 0) { %>
      <p class="text-muted">No no-shows recorded.</p>
    <% } else { %>
      <div class="table-wrap" role="region" aria-labelledby="missed-title" tabindex="0">
        <table class="admin-table" aria-labelledby="missed-title">
          <thead><tr><th scope="col">Name</th><th scope="col">Phone</th><th scope="col">Missed</th></tr></thead>
          <tbody>
            <% noShows.forEach(function (row) { %>
              <tr><td><%= row.senior ? row.senior.fullName : '(deleted)' %></td><td><%= row.senior ? row.senior.phone : '' %></td><td><%= row.get('total') %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<script src="/js/dashboard.js?v=ui1" defer></script>
<%- include('../partials/footer') %>
