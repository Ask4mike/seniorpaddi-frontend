<%- include('../partials/header') %>

<h1 class="mb-6">Reports</h1>

<h2 class="mb-3">Waiting for review</h2>
<% if (pending.length === 0) { %>
  <p class="empty-state mb-10"><i class="fa-solid fa-circle-check mr-2 text-success" aria-hidden="true"></i>No open reports.</p>
<% } else { %>
  <ul class="mb-10 space-y-3">
    <% pending.forEach(function (r) { %>
      <li class="queue-row">
        <span class="chip-status chip-danger"><i class="fa-solid fa-flag" aria-hidden="true"></i>Reported</span>
        <span class="min-w-0 flex-1">
          <a href="/admin/reports/<%= r.id %>" class="inline-flex min-h-12 items-center"><span><strong><%= r.reporter ? r.reporter.fullName : '(deleted)' %></strong> reported <strong><%= r.reported ? r.reported.fullName : '(deleted)' %></strong></span></a><br>
          <span class="text-base text-muted"><%= formatDate(r.createdAt) %></span>
        </span>
      </li>
    <% }) %>
  </ul>
<% } %>

<h2 id="closed-title" class="mb-3">Recently closed</h2>
<% if (recent.length === 0) { %>
  <p>None yet.</p>
<% } else { %>
  <div class="table-wrap" role="region" aria-labelledby="closed-title" tabindex="0">
    <table class="admin-table" aria-labelledby="closed-title">
      <thead><tr><th scope="col">Reported</th><th scope="col">Outcome</th><th scope="col">Closed</th></tr></thead>
      <tbody>
        <% recent.forEach(function (r) { %>
          <tr>
            <td><a href="/admin/reports/<%= r.id %>" class="inline-flex min-h-12 items-center"><%= r.reported ? r.reported.fullName : '(deleted)' %></a></td>
            <td><%= { warned: 'Warned', removed: 'Removed from social', dismissed: 'Dismissed' }[r.status] %></td>
            <td><%= r.reviewedAt ? formatDate(r.reviewedAt) : '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
