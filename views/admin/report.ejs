<%- include('../partials/header') %>

<p class="mb-2"><a href="/admin/reports" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Back to reports</a></p>
<h1 class="mb-4">Report</h1>

<dl class="card mb-6 space-y-3">
  <div><dt class="font-bold">Reported by</dt><dd><%= report.reporter ? report.reporter.fullName + ' (' + report.reporter.phone + ')' : '(deleted)' %></dd></div>
  <div><dt class="font-bold">About</dt><dd><%= report.reported ? report.reported.fullName + ' (' + report.reported.phone + ')' : '(deleted)' %><% if (otherReports > 0) { %> <span class="tag-amber"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><%= otherReports %> other report(s)</span><% } %></dd></div>
  <div><dt class="font-bold">When</dt><dd><%= formatDate(report.createdAt) %>, <%= formatTime(report.createdAt) %></dd></div>
  <div><dt class="font-bold">Reason given</dt><dd><%= report.reason || 'None given' %></dd></div>
</dl>

<h2 class="mb-3">Conversation (last 50 messages)</h2>
<% if (report.conversationSnapshot.length === 0) { %>
  <p class="panel mb-8">They hadn't messaged each other.</p>
<% } else { %>
  <ol class="mb-8 space-y-3">
    <% report.conversationSnapshot.forEach(function (m) { %>
      <li class="rounded-xl p-4 <%= m.from === 'reported' ? 'bg-warning-bg' : 'bg-surface-muted' %>">
        <strong><%= m.from === 'reported' ? 'Reported senior' : 'Reporter' %>:</strong> <%= m.body %>
        <br><span class="text-base text-muted"><%= formatDate(m.at) %>, <%= formatTime(m.at) %></span>
      </li>
    <% }) %>
  </ol>
<% } %>

<% if (report.status === 'pending') { %>
  <h2 class="mb-2">Decision</h2>
  <p class="measure mb-4 text-base">Whatever you choose, the reporter keeps the reported senior hidden and their conversation stays paused.</p>
  <form action="/admin/reports/<%= report.id %>/resolve" method="post" class="flex flex-wrap gap-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button name="action" value="warn" class="btn"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>Warn</button>
    <button name="action" value="remove" class="btn-danger"><i class="fa-solid fa-user-slash" aria-hidden="true"></i>Remove from social</button>
    <button name="action" value="dismiss" class="btn-plain"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Dismiss</button>
  </form>
<% } else { %>
  <p class="panel">Closed: <%= report.status %>.</p>
<% } %>

<%- include('../partials/footer') %>
