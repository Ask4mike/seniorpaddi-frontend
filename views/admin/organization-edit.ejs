<%- include('../partials/header') %>

<p class="mb-2"><a href="/admin/organizations" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Back to organizations</a></p>
<h1 class="mb-6">Edit <%= org.name %></h1>
<% if (error) { %><div role="alert" class="alert alert-error"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i><span><%= error %></span></div><% } %>

<form action="/admin/organizations/<%= org.id %>/edit" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('orgFields', { org }) %>
  <button class="btn">Save changes</button>
</form>

<%- include('../partials/footer') %>
