<%- include('../partials/header') %>
<%
  function status(ok, onText, offText) {
    return ok ? '<span class="tag-leaf"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>' + onText + '</span>' : '<span class="tag-full"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>' + offText + '</span>';
  }
%>

<h1 id="system-title" class="mb-2">System</h1>
<p class="measure mb-8">A quick check that everything is working. If something is red, see the "Fixing problems" part of the handover guide.</p>

<% if (warnings.length > 0) { %>
  <section class="alert alert-warning mb-8">
    <i class="fa-solid fa-triangle-exclamation mt-1" aria-hidden="true"></i>
    <div class="min-w-0">
      <h2 class="mb-2 text-xl">Needs attention</h2>
      <ul class="list-disc space-y-1 pl-6 font-normal">
        <% warnings.forEach(function (w) { %><li><%= w %></li><% }) %>
      </ul>
    </div>
  </section>
<% } %>

<div class="table-wrap mb-10" role="region" aria-labelledby="system-title" tabindex="0">
  <table class="admin-table" aria-labelledby="system-title">
    <tbody>
      <tr><th scope="row">Website</th><td><%= appUrl %><br><span class="text-base text-muted">Running since <%= startedAt ? formatDate(startedAt) + ', ' + formatTime(startedAt) : '–' %></span></td></tr>
      <tr><th scope="row">Database</th><td><%- status(dbOk, 'Connected', 'Not reachable') %> <span class="text-base text-muted"><%= dbHost %></span></td></tr>
      <tr><th scope="row">Database updates</th><td>
        <% if (migrations.pending.length === 0) { %><%- status(true, 'Up to date', '') %> <span class="text-base text-muted"><%= migrations.executed.length %> applied</span>
        <% } else { %><%- status(false, '', migrations.pending.length + ' waiting') %> <span class="text-base text-muted">Restart the app to apply them.</span><% } %>
      </td></tr>
      <tr><th scope="row">Texts and emails (Brevo)</th><td>
        <% if (brevo === 'on') { %><%- status(true, 'Sending', '') %>
        <% } else if (brevo === 'test') { %><span class="tag-amber"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>Test mode, not sending</span>
        <% } else { %><%- status(false, '', 'Not set up') %><% } %>
      </td></tr>
      <tr><th scope="row">Uploads (Cloudinary)</th><td><%- status(cloudinary, 'On', 'Not set up') %></td></tr>
      <tr><th scope="row">Reminder texts</th><td>Every day at 8am. <span class="text-base text-muted">
        <%= lastRuns.reminders ? 'Last run ' + formatDate(lastRuns.reminders) + ', ' + formatTime(lastRuns.reminders) + ' (' + lastRuns.remindersSent + ' sent)' : 'Not run since the last restart.' %></span></td></tr>
    </tbody>
  </table>
</div>

<h2 class="mb-3">In numbers</h2>
<ul class="space-y-1">
  <li><strong><%= counts.seniors %></strong> seniors</li>
  <li><strong><%= counts.upcomingEvents %></strong> upcoming events</li>
  <li><strong><%= counts.registrations %></strong> places booked for upcoming events</li>
</ul>

<%- include('../partials/footer') %>
