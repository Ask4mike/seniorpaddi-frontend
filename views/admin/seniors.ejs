<%- include('../partials/header') %>

<h1 class="mb-6">Seniors</h1>

<form action="/admin/seniors" method="get" class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end">
  <div class="field mb-0 flex-1">
    <label for="q">Search by name or phone</label>
    <input type="text" id="q" name="q" value="<%= q %>">
  </div>
  <button class="btn-plain"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>Search</button>
</form>

<% if (seniors.length === 0) { %>
  <p class="panel">No seniors found.</p>
<% } %>

<ul class="space-y-4">
  <% seniors.forEach(function (s) { %>
    <li class="border-b border-border-strong pb-4">
      <strong><%= s.fullName %></strong><br>
      <%= s.phone %><%= s.email ? ', ' + s.email : '' %><br>
      <span class="text-base text-muted">Joined <%= formatDate(s.createdAt) %>. Language: <span lang="<%= s.preferredLanguage === 'yo' ? 'yo' : 'en' %>"><%= s.preferredLanguage === 'yo' ? 'Yorùbá' : 'English' %></span>.
        ID: <%= { unverified: 'not sent', pending: 'waiting for check', approved: 'verified', rejected: 'sent back', social_removed: 'removed from social' }[s.verificationStatus] %>.</span>
      <% const safeName = s.fullName.replace(/'/g, ''); %>
      <div class="-ml-2 mt-1 flex flex-wrap gap-3">
        <form action="/admin/seniors/<%= s.id %>/reset-password" method="post"
              onsubmit="return confirm('Reset the password for <%= safeName %>? They will get a text with a temporary one.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-link">Reset password</button>
        </form>
        <% if (s.verificationStatus === 'approved') { %>
          <form action="/admin/seniors/<%= s.id %>/remove-from-social" method="post"
                onsubmit="return confirm('Remove <%= safeName %> from Find Seniors and messages? Their events are not affected.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn-link-danger">Remove from social</button>
          </form>
        <% } %>
        <form action="/admin/seniors/<%= s.id %>/delete" method="post"
              onsubmit="return confirm('Delete the account of <%= safeName %>? Upcoming places are cancelled. Past attendance is kept.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-link-danger">Delete account</button>
        </form>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
