<%- include('../partials/header') %>

<h1 class="mb-2">ID checks</h1>
<p class="measure mb-6">Check that the name matches and the person looks 60 or older. Rejecting never affects their events.</p>

<% if (pending.length === 0) { %>
  <p class="empty-state"><i class="fa-solid fa-circle-check mr-2 text-success" aria-hidden="true"></i>No IDs waiting.</p>
<% } %>

<%# queue list (Halden decision queue, ref 3, in the light theme): one row per person, status chip, actions %>
<ul class="space-y-4">
  <% pending.forEach(function (s) { %>
    <li class="card">
      <div class="mb-3 flex flex-wrap items-center gap-4">
        <span class="avatar h-12 w-12 text-xl" aria-hidden="true"><%= s.fullName.charAt(0) %></span>
        <div class="min-w-0 flex-1">
          <h2 class="text-xl"><%= s.fullName %></h2>
          <p class="text-muted"><%= s.phone %>. Sent <%= formatDate(s.updatedAt) %>.</p>
        </div>
        <span class="chip-status chip-pending"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>ID pending</span>
      </div>

      <%# no auto-loading: the link makes a 5-minute signed URL and is logged %>
      <a href="/admin/ids/<%= s.id %>/view" target="_blank" rel="noopener" class="btn-plain mb-4"><i class="fa-solid fa-id-card" aria-hidden="true"></i>View ID</a>

      <div class="grid gap-4 sm:grid-cols-2 sm:items-start">
        <form action="/admin/ids/<%= s.id %>/approve" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-volunteer btn-block"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Approve</button>
        </form>
        <form action="/admin/ids/<%= s.id %>/reject" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field mb-3">
            <label for="reason-<%= s.id %>">Reason (they will see this)</label>
            <input type="text" id="reason-<%= s.id %>" name="reason" placeholder="e.g. The picture is too blurry to read">
          </div>
          <button class="btn-plain btn-block"><i class="fa-solid fa-reply" aria-hidden="true"></i>Send back</button>
        </form>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
