<%- include('../partials/header') %>

<p class="mb-2"><a href="/admin/events" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Back to events</a></p>
<h1 id="attendance-title" class="mb-1">Attendance</h1>
<p id="attendance-event" class="mb-1 text-xl font-bold"><%= event.title %></p>
<p class="mb-6"><%= formatDate(event.startsAt) %>, <%= formatTime(event.startsAt) %>, <%= event.Organization.name %></p>

<% if (!hasStarted) { %>
  <div class="panel mb-6">
    <p class="mb-3">This event hasn't happened yet. Print this page and take it to the event to tick people off, then come back and enter it here.</p>
    <button type="button" onclick="window.print()" class="btn-plain"><i class="fa-solid fa-print" aria-hidden="true"></i>Print list</button>
  </div>
<% } %>

<form action="/admin/events/<%= event.id %>/checkin" method="post" class="panel mb-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field mb-3">
    <label for="ticket">Check in by ticket number</label>
    <input type="text" id="ticket" name="ticket" placeholder="SP-7K3QX9" autocapitalize="characters" required aria-describedby="ticket-hint">
    <span class="hint" id="ticket-hint">The number is in the senior's SMS or email.</span>
  </div>
  <button class="btn">Check in</button>
</form>

<p class="mb-4 font-bold"><%= registrations.filter(function (r) { return r.Attendance; }).length %> of <%= registrations.length %> checked in.</p>

<% if (registrations.length === 0) { %>
  <p class="panel">Nobody is registered for this event.</p>
<% } else { %>
  <form action="/admin/events/<%= event.id %>/attendance" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="table-wrap mb-6" role="region" aria-labelledby="attendance-title attendance-event" tabindex="0">
      <table class="admin-table" aria-labelledby="attendance-title attendance-event">
        <thead>
          <tr><th scope="col">Name</th><th scope="col">Ticket</th><th scope="col">As</th><th scope="col">Came</th><th scope="col">Didn't come</th><th scope="col">Not marked</th></tr>
        </thead>
        <tbody>
          <% registrations.forEach(function (reg) { %>
            <tr>
              <td><strong id="att-name-<%= reg.id %>"><%= reg.senior ? reg.senior.fullName : '(deleted)' %></strong></td>
              <td><%= reg.ticketNumber %><% if (reg.Attendance) { %><br><span class="text-base text-muted"><%= { manual: 'list', qr: 'QR', ticket: 'ticket' }[reg.Attendance.method] %>, <%= formatTime(reg.Attendance.checkedInAt) %></span><% } %></td>
              <td><%= reg.type === 'volunteer' ? 'Volunteer' : 'Attendee' %></td>
              <% [['attended', 'Came'], ['no_show', "Didn't come"], ['registered', 'Not marked']].forEach(function (opt) { %>
                <td>
                  <label class="check justify-center">
                    <input type="radio" aria-labelledby="att-name-<%= reg.id %> att-<%= reg.id %>-<%= opt[0] %>" name="status_<%= reg.id %>" value="<%= opt[0] %>" class="h-6 w-6" <%= reg.status === opt[0] ? 'checked' : '' %>>
                    <span class="sr-only" id="att-<%= reg.id %>-<%= opt[0] %>"><%= opt[1] %></span>
                  </label>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <button class="btn">Save attendance</button>
  </form>
<% } %>

<%- include('../partials/footer') %>
