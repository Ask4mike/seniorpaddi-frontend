<%- include('../partials/header') %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1>Events</h1>
  <a href="/admin/events/new" class="btn"><i class="fa-solid fa-plus" aria-hidden="true"></i>Add event</a>
</div>

<% if (events.length === 0) { %>
  <p class="panel">No events yet.</p>
<% } %>

<ul class="grid gap-4 lg:grid-cols-2">
  <% events.forEach(function (event) { %>
    <li class="card flex flex-col gap-4 sm:flex-row">
      <%- include('../partials/eventImage', { event, imgClass: 'h-32 w-full shrink-0 rounded-xl object-cover sm:h-28 sm:w-36' }) %>
      <div class="min-w-0 flex-1">
      <p class="mb-2 flex flex-wrap gap-2">
        <% if (event.status === 'cancelled') { %><span class="tag-full"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>Cancelled</span>
        <% } else if (event.status === 'completed') { %><span class="tag-mine"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Finished</span>
        <% } else { %><span class="tag-leaf"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Published</span><% } %>
        <% if (event.hostedBySenior) { %><span class="tag-leaf"><i class="fa-solid fa-house-user" aria-hidden="true"></i>Hosted by a senior</span><% } %>
      </p>
      <h2 class="mb-1 text-xl"><%= event.title %></h2>
      <p><%= formatDate(event.startsAt) %>, <%= formatTime(event.startsAt) %> at <%= event.locationText %></p>
      <p class="mb-3"><%= event.Organization.name %></p>
      <div class="-ml-2 flex flex-wrap gap-3">
        <a href="/events/<%= event.id %>" class="btn-link">View as senior</a>
        <a href="/admin/events/<%= event.id %>/edit" class="btn-link">Edit</a>
        <a href="/admin/events/<%= event.id %>/attendance" class="btn-link">Attendance</a>
        <% if (event.status === 'published') { %>
          <form action="/admin/events/<%= event.id %>/cancel" method="post" onsubmit="return confirm('Cancel this event? Everyone registered will get a message.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn-link-danger">Cancel event</button>
          </form>
        <% } %>
      </div>
      </div>
    </li>
  <% }) %>
</ul>

<%- include('../partials/footer') %>
